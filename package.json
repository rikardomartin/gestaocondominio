{
  "name": "condominio-management-pwa",
  "version": "2.0.0",
  "description": "Sistema PWA de Gestão Condominial com Firebase",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "python -m http.server 8000",
    "setup-users": "node setup-demo-users.js",
    "build": "echo 'PWA build complete'",
    "deploy": "firebase deploy",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:install": "playwright install chromium",
    "serve": "http-server . -p 3000 -c-1",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:run": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:all": "npm run test:unit:run && npm run test"
  },
  "keywords": [
    "pwa",
    "condominio",
    "firebase",
    "gestao",
    "pagamentos"
  ],
  "author": "Sistema de Gestão Condominial",
  "license": "MIT",
  "dependencies": {
    "firebase": "^10.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "firebase-tools": "^13.0.0",
    "happy-dom": "^20.9.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seu-usuario/condominio-management"
  },
  "bugs": {
    "url": "https://github.com/seu-usuario/condominio-management/issues"
  },
  "homepage": "https://condominio-management.web.app"
}
